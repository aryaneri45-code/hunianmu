{% macro icon(name='home') %}<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{% if name=='search' %}<circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/>{% elif name=='arrow' %}<path d="M4 12h16m-6-6 6 6-6 6"/>{% elif name=='pin' %}<path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/>{% elif name=='check' %}<path d="m5 12 4 4L19 6"/>{% elif name=='wifi' %}<path d="M3 8a15 15 0 0 1 18 0M6 12a10 10 0 0 1 12 0m-8 4a3 3 0 0 1 4 0"/><circle cx="12" cy="20" r=".5"/>{% elif name=='chat' %}<path d="M21 11.5a9 9 0 0 1-13 8L3 21l1.5-5A9 9 0 1 1 21 11.5Z"/><path d="M8 8c1 4 3 6 7 7l1-2-3-1-1 1-2-2 1-1-1-3-2 1Z"/>{% elif name=='bed' %}<path d="M3 19V7m0 8h18v4M3 10h5v5m0-3h10a3 3 0 0 1 3 3"/>{% elif name=='land' %}<path d="m3 18 6-12 5 8 3-5 4 9H3Z"/>{% elif name=='snowflake' %}<path d="M12 2v20M3.3 7l17.4 10M3.3 17 20.7 7M9 4l3 3 3-3M9 20l3-3 3 3"/>{% elif name=='bath' %}<path d="M3 12h18v4a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4v-4ZM5 12V5a2 2 0 0 1 4 0M6 20v2m12-2v2"/>{% elif name=='car' %}<path d="m4 10 2-6h12l2 6M3 10h18v8H3zM5 18v3m14-3v3M6 14h2m8 0h2"/>{% elif name=='building' %}<path d="M4 21V3h11v18M15 9h5v12M8 7h3M8 11h3M8 15h3M2 21h20"/>{% elif name=='shield' %}<path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z"/><path d="m8 12 3 3 5-6"/>{% else %}<path d="m3 10 9-7 9 7v10H3V10Z"/><path d="M9 20v-7h6v7"/>{% endif %}</svg>{% endmacro %}
{% macro wa(label='Hubungi Admin',context='general',id='') %}<a class="btn btn-wa" href="/whatsapp?context={{ context }}{% if id %}&amp;property_id={{ id }}{% endif %}" data-wa>{{ icon('chat') }}{{ label }}</a>{% endmacro %}
{% macro csrf(value) %}<input type="hidden" name="_csrf" value="{{ value }}">{% endmacro %}
{% macro field(label,name,value='',type='text',required=false,hint='') %}<label class="field">{{ label }}{% if required %} <span aria-hidden="true">*</span>{% endif %}<input name="{{ name }}" type="{{ type }}" value="{{ value }}" {% if required %}required{% endif %}{% if type=='number' %} min="0" step="any"{% endif %}>{% if hint %}<small>{{ hint }}</small>{% endif %}<span class="field-error" data-error-for="{{ name }}"></span></label>{% endmacro %}
{% macro card(p) %}<article class="property-card"><a class="card-photo" href="{{ p | propertyPath }}"><img src="{{ p.cover or '/static/img/property-placeholder.svg' }}" alt="{{ p.title }}" width="480" height="320" loading="lazy"><span class="badge availability-{{ p.availability }}">{{ p.availability | availability }}</span><span class="photo-category">{{ p.category_name }}</span></a><div class="card-body"><div class="price">{{ p.price | money }} <span>{{ p.price_period | period }}</span></div><h3><a href="{{ p | propertyPath }}">{{ p.title }}</a></h3><p class="location">{{ icon('pin') }}{{ p.location_name }}</p><div class="spec-strip"><span>{{ icon('bed') }}{{ p.bedrooms }} KT</span><span>{{ p.bathrooms }} KM</span><span>{{ p.land_area or p.building_area }} m²</span></div><div class="card-actions"><a class="btn btn-light" href="{{ p | propertyPath }}">Lihat Detail {{ icon('arrow') }}</a><a class="btn btn-wa" data-wa href="/whatsapp?context=listing&amp;property_id={{ p.id }}">{{ icon('chat') }}Tanya</a></div></div></article>{% endmacro %}

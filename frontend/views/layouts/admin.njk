{% from 'partials/macros.njk' import icon,csrf as csrfField %}<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ title }} — Admin HunianMu</title><meta name="robots" content="noindex,nofollow"><meta name="csrf-token" content="{{ csrf }}"><link rel="icon" href="/static/img/favicon.svg"><link rel="stylesheet" href="/static/build/main.css"><script src="/static/build/admin.js" defer></script></head><body class="admin-body"><a class="skip" href="#content">Langsung ke konten</a><aside class="admin-sidebar"><a class="brand" href="/admin"><img src="/static/img/logo.webp" width="142" height="48" alt="HunianMu"></a><p class="admin-label">RUANG KELOLA</p><nav aria-label="Navigasi admin"><a href="/admin" {% if path=='/admin' %}aria-current="page"{% endif %}>{{ icon('home') }}Dasbor</a><a href="/admin/properties" {% if path and path.startsWith('/admin/properties') %}aria-current="page"{% endif %}>{{ icon('building') }}Listing Properti</a><a href="/admin/master-data" {% if path=='/admin/master-data' %}aria-current="page"{% endif %}>{{ icon('land') }}Master Data</a><a href="/admin/packages" {% if path=='/admin/packages' %}aria-current="page"{% endif %}>{{ icon('check') }}Paket Iklan</a><a href="/admin/requests/ad" {% if path=='/admin/requests/ad' %}aria-current="page"{% endif %}>{{ icon('chat') }}Pengajuan Iklan</a><a href="/admin/requests/survey" {% if path=='/admin/requests/survey' %}aria-current="page"{% endif %}>{{ icon('pin') }}Pengajuan Survei</a><a href="/admin/settings" {% if path=='/admin/settings' %}aria-current="page"{% endif %}>{{ icon('shield') }}Pengaturan Situs</a></nav><a class="btn btn-light" href="/" target="_blank" rel="noopener">Lihat Website {{ icon('arrow') }}</a></aside><div class="admin-main"><header class="admin-header"><span>Panel Admin / {{ title }}</span><div><span>{{ admin.name }}</span><form method="post" action="/api/admin/logout">{{ csrfField(csrf) }}<button class="btn btn-light">Keluar</button></form></div></header><main id="content" class="admin-content">{% block content %}{% endblock %}</main></div></body></html>

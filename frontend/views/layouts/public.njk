{% from 'partials/macros.njk' import icon,wa %}
<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ title or 'HunianMu' }}</title><meta name="description" content="{{ description or 'Temukan properti dan layanan iklan HunianMu.' }}">{% if adminPage %}<meta name="robots" content="noindex,nofollow">{% else %}<link rel="canonical" href="{{ canonical }}"><meta property="og:type" content="website"><meta property="og:locale" content="id_ID"><meta property="og:site_name" content="HunianMu"><meta property="og:title" content="{{ title }}"><meta property="og:description" content="{{ description }}"><meta property="og:url" content="{{ canonical }}">{% if ogImage %}<meta property="og:image" content="{{ ogImage }}">{% endif %}{% endif %}<link rel="icon" href="/static/img/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="/static/build/main.css"><script src="/static/build/public.js" defer></script>{% if structured %}<script type="application/ld+json">{{ structured | jsonld }}</script>{% endif %}</head><body>
<a class="skip" href="#content">Langsung ke konten</a>
<header class="site-header"><div class="header-inner"><a href="/" class="brand" aria-label="HunianMu Beranda"><img src="/static/img/logo.webp" width="142" height="48" alt="HunianMu"></a><nav aria-label="Navigasi utama" id="main-nav"><a href="/" {% if path=='/' %}aria-current="page"{% endif %}>Beranda</a><a href="/properti" {% if path and path.startsWith('/properti') %}aria-current="page"{% endif %}>Cari Properti</a><a href="/iklankan" {% if path=='/iklankan' %}aria-current="page"{% endif %}>Iklankan Properti/Usaha</a><a href="/cara-kerja" {% if path=='/cara-kerja' %}aria-current="page"{% endif %}>Cara Kerja</a><a href="/kontak" {% if path=='/kontak' %}aria-current="page"{% endif %}>Kontak</a></nav><div class="header-actions">{{ wa('Hubungi Admin') }}<button class="menu-toggle" aria-label="Buka menu navigasi" aria-expanded="false" aria-controls="main-nav">☰</button></div></div></header>
{% if settings.demo_mode=='true' %}<div class="demo-banner">Mode demo lokal · Listing, harga paket, dan nomor WhatsApp untuk pengujian.</div>{% endif %}
<main id="content">{% block content %}{% endblock %}</main>
<footer class="site-footer"><div class="container footer-grid"><div><a href="/" class="brand footer-brand">Hunian<span>Mu</span><small>PROPERTY ECOSYSTEM</small></a><p>Tempat baru, cerita baru.<br>Temukan properti dan pasarkan usahamu bersama HunianMu.</p></div><div><h3>Jelajahi HunianMu</h3><a href="/properti">Cari Properti</a><a href="/iklankan">Iklankan Properti/Usaha</a><a href="/cara-kerja">Cara Kerja</a></div><div><h3>Terhubung dengan kami</h3><p>{{ settings.service_area }}<br>{{ settings.service_hours }}</p><a href="/kontak">Kontak & media sosial</a><a href="/kebijakan-privasi">Kebijakan Privasi</a></div></div><div class="container footer-bottom"><span>© {{ 2026 }} HunianMu. Semua hak dilindungi.</span><a href="/admin">Panel Admin {{ icon('arrow') }}</a></div></footer>
</body></html>

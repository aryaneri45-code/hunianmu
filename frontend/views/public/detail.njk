{% extends 'layouts/public.njk' %}{% from 'partials/macros.njk' import icon,wa,field %}{% block content %}
<div class="container detail-page">{% if preview %}<div class="notice">Pratinjau admin · Listing draf tidak dapat diakses publik. <a href="/admin/properties/{{ property.id }}">Kembali mengedit</a></div>{% endif %}<nav class="breadcrumb" aria-label="Breadcrumb"><a href="/properti">Cari Properti</a><span>/</span><a href="/properti/{{ property.category_slug }}">{{ property.category_name }}</a><span>/ {{ property.code }}</span></nav>
<div class="gallery" aria-label="Galeri foto properti">{% for m in property.media %}<button class="gallery-item" data-gallery="{{ loop.index0 }}" type="button" aria-label="Perbesar foto {{ loop.index }}: {{ m.alt }}"><img src="{{ m.medium_path }}" srcset="{{ m.thumb_path }} 480w, {{ m.medium_path }} 960w, {{ m.path }} 1600w" sizes="(max-width:767px) 95vw, 60vw" alt="{{ m.alt }}" width="{{ m.width }}" height="{{ m.height }}" {% if loop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}></button>{% else %}<img src="/static/img/property-placeholder.svg" width="1200" height="800" alt="Foto listing belum tersedia">{% endfor %}</div><p class="gallery-hint">{{ property.media | length }} foto · Geser untuk melihat, ketuk untuk memperbesar.</p>
<dialog id="photo-dialog"><div class="dialog-toolbar"><button type="button" data-photo-prev aria-label="Foto sebelumnya">←</button><span data-photo-count></span><button type="button" data-photo-next aria-label="Foto berikutnya">→</button><button type="button" data-photo-close>Tutup ×</button></div><img alt="" id="zoom-photo"></dialog>
<div class="detail-layout"><div><div class="detail-title"><span class="badge availability-{{ property.availability }}">{{ property.availability | availability }}</span><span class="pill">{{ property.code }}</span><span class="pill">{{ property.category_name }}{% if property.kos_type %} · {{ property.kos_type | capitalize }}{% endif %}</span><h1>{{ property.title }}</h1><p class="location">{{ icon('pin') }}{{ property.public_address }}, {{ property.location_name }}</p><small>Diperbarui {{ property.updated_at | date }}</small></div><section class="panel"><h2>Tentang properti</h2><p class="pre-line">{{ property.description }}</p></section><section class="panel"><h2>Spesifikasi</h2><dl class="spec-grid"><div><dt>Luas tanah</dt><dd>{{ property.land_area }} m²</dd></div><div><dt>Luas bangunan</dt><dd>{{ property.building_area }} m²</dd></div><div><dt>Kamar tidur</dt><dd>{{ property.bedrooms }}</dd></div><div><dt>Kamar mandi</dt><dd>{{ property.bathrooms }}</dd></div>{% if property.room_size %}<div><dt>Ukuran kamar</dt><dd>{{ property.room_size }}</dd></div>{% endif %}{% if property.certificate %}<div><dt>Sertifikat</dt><dd>{{ property.certificate }}</dd></div>{% endif %}{% if property.furniture %}<div><dt>Furnitur</dt><dd>{{ property.furniture }}</dd></div>{% endif %}</dl></section><section class="panel"><h2>Fasilitas</h2><div class="facility-grid">{% for f in property.facilities %}<span>{{ icon(f.icon) }}{{ f.name }}</span>{% else %}<p>Informasi fasilitas dapat ditanyakan kepada admin.</p>{% endfor %}</div></section>{% if property.rules %}<section class="panel"><h2>Aturan & informasi tambahan</h2><p class="pre-line">{{ property.rules }}</p></section>{% endif %}{% if property.video_url %}<section class="panel"><h2>Kenali lebih dekat</h2><p>Lihat video properti di YouTube.</p><a class="btn btn-light" href="{{ property.video_url }}" target="_blank" rel="noopener noreferrer">Buka Video {{ icon('arrow') }}</a></section>{% endif %}</div>
<aside><div class="panel price-panel"><p>Harga properti</p><div class="detail-price">{{ property.price | money }}<span>{{ property.price_period | period }}</span></div><p><span class="status-dot"></span>{{ property.availability | availability }}</p>{{ wa('Tanya Ketersediaan','listing',property.id) }}<a class="btn btn-light" href="#survei">Ajukan Survei {{ icon('arrow') }}</a><small>Semua pertanyaan ditangani admin HunianMu.</small></div><section class="panel" id="survei"><h2>Ingin lihat langsung?</h2><p>Ajukan jadwal survei. Admin akan mengonfirmasi waktu kunjungan.</p><form action="/api/survey-requests" method="post" data-public-form><input type="hidden" name="property_id" value="{{ property.id }}">{{ field('Nama','name','','text',true) }}{{ field('Nomor WhatsApp','whatsapp','','tel',true,'Contoh: 081234567890') }}{{ field('Tanggal & jam (WIB)','preferred_at','','datetime-local',true) }}<label class="honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"></label><p class="form-feedback" role="alert" tabindex="-1"></p><small>Data tersimpan untuk tindak lanjut sesuai <a href="/kebijakan-privasi">Kebijakan Privasi</a>.</small><button class="btn btn-primary">Simpan & Lanjut ke WhatsApp</button></form></section></aside></div></div><div class="mobile-detail-bar"><div><strong>{{ property.price | money }}</strong><small>{{ property.price_period | period }}</small></div>{{ wa('Tanya Ketersediaan','listing',property.id) }}</div>
{% endblock %}

{% extends 'layouts/public.njk' %}{% from 'partials/macros.njk' import icon,wa,card %}
{% block content %}
<section class="hero"><div class="container"><div class="eyebrow hero-eyebrow">{{ icon('shield') }} KATALOG PROPERTI · WHATSAPP-FIRST</div><h1>Temukan tempat untuk<br><span>cerita barumu.</span></h1><p>Indekos pertama, rumah keluarga, hingga ruang usaha.<br class="desktop-only"> Cari yang pas, bicarakan langsung dengan admin HunianMu.</p><div class="search-dock"><div class="search-caption">Mulai pencarianmu di sini</div><form action="/properti" class="home-search"><label>Kata kunci<div class="input-icon">{{ icon('search') }}<input name="q" placeholder="Nama properti, area, atau kampus"></div></label><label>Kategori<select name="category"><option value="">Semua kategori</option>{% for t in types %}<option value="{{ t.slug }}">{{ t.name }}</option>{% endfor %}</select></label><label>Lokasi<select name="location"><option value="">Semua lokasi</option>{% for l in locations %}<option value="{{ l.slug }}">{{ l.name }}</option>{% endfor %}</select></label><button class="btn btn-primary">{{ icon('search') }}Cari Properti</button></form><div class="search-hint">Kenali kebutuhanmu. Bandingkan pilihanmu. Kami bantu langkah berikutnya.</div></div><div class="hero-benefits"><span>{{ icon('home') }} Beragam pilihan properti</span><span>{{ icon('chat') }} Satu pintu ke admin</span><span>{{ icon('shield') }} Informasi yang mudah diakses</span></div></div></section>
<section class="section container"><div class="section-heading"><div><p class="eyebrow">EKSPLORASI KATEGORI</p><h2>Ada ruang untuk setiap kebutuhan.</h2></div><p>Mulai dari tipe properti<br>yang sedang kamu cari.</p></div><div class="categories">{% for c in categories %}<a href="/properti/{{ c.slug }}" class="category-card"><span class="category-icon">{{ icon(('bed' if c.slug=='indekos' else ('building' if c.slug=='kontrakan' else ('land' if c.slug=='tanah' else 'home')))) }}</span><h3>{{ c.name }}</h3><span>{{ c.count }} listing terbit</span>{{ icon('arrow') }}</a>{% endfor %}</div></section>
<section class="section tinted"><div class="container"><div class="section-heading"><div><p class="eyebrow">PILIHAN HUNIANMU</p><h2>Pilihan yang layak kamu lihat.</h2></div><a href="/properti" class="text-link">Lihat semua properti {{ icon('arrow') }}</a></div><div class="property-grid">{% for p in items %}{{ card(p) }}{% else %}<div class="empty">Listing pilihan sedang disiapkan. <a href="/properti">Jelajahi katalog</a>.</div>{% endfor %}</div></div></section>
<section class="section container"><div class="section-heading"><div><p class="eyebrow">KENALI LINGKUNGANNYA</p><h2>Dekat dengan keseharianmu.</h2></div><p>{{ settings.service_area }}</p></div><div class="location-grid">{% for l in locations %}<a href="/properti?location={{ l.slug }}">{{ icon('pin') }}<strong>{{ l.name }}</strong>{{ icon('arrow') }}</a>{% endfor %}</div></section>
<section class="section ad-section"><div class="container ad-split"><div><p class="eyebrow">UNTUK PEMILIK PROPERTI & USAHA</p><h2>Ruangmu punya potensi.<br>Biar lebih banyak yang tahu.</h2><p>Tampilkan properti atau usahamu dengan informasi yang jelas dan promosi yang sesuai kebutuhan.</p><a href="/iklankan" class="btn btn-primary">Iklankan Properti/Usaha {{ icon('arrow') }}</a></div><div class="service-list"><article>{{ icon('building') }}<div><h3>Listing Website</h3><p>Halaman detail, galeri foto, dan akses mudah melalui pencarian.</p></div></article><article>{{ icon('chat') }}<div><h3>Promosi Media Sosial</h3><p>Perkenalkan properti dan usaha melalui konten media sosial.</p></div></article><article>{{ icon('shield') }}<div><h3>Paket Gabungan</h3><p>Website dan media sosial untuk jangkauan yang saling melengkapi.</p></div></article></div></div></section>
<section class="section container"><div class="contact-band"><div><p class="eyebrow">KAMI SIAP MEMBANTU</p><h2>Belum menemukan yang cocok?</h2><p>Ceritakan lokasi, anggaran, dan kebutuhanmu kepada admin.</p></div>{{ wa('Bantu Carikan Properti','search') }}</div></section>
{% endblock %}

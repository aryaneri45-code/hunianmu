{% extends 'layouts/public.njk' %}{% from 'partials/macros.njk' import icon,wa,card %}{% block content %}
<div class="container page-intro"><p class="eyebrow">KATALOG HUNIANMU</p><h1>{{ heading }}</h1><p>Pilih lokasi, sesuaikan anggaran, dan temukan pilihanmu.</p></div><div class="container catalog-layout"><aside><form action="/properti" class="panel filter-form"><div class="section-heading"><h2>Filter pencarian</h2><a href="/properti">Reset</a></div><label>Kata kunci<input name="q" value="{{ filters.q }}" placeholder="Judul, lokasi, deskripsi"></label><label>Kategori<select name="category"><option value="">Semua kategori</option>{% for t in types %}<option value="{{ t.slug }}" {% if t.slug==filters.category %}selected{% endif %}>{{ t.name }}</option>{% endfor %}</select></label><label>Lokasi<select name="location"><option value="">Semua lokasi</option>{% for l in locations %}<option value="{{ l.slug }}" {% if l.slug==filters.location %}selected{% endif %}>{{ l.name }}</option>{% endfor %}</select></label><div class="form-grid"><label>Harga minimum<input name="min_price" type="number" min="0" value="{{ filters.min_price }}" placeholder="Rp"></label><label>Harga maksimum<input name="max_price" type="number" min="0" value="{{ filters.max_price }}" placeholder="Rp"></label></div><small>Harga nominal sesuai periode masing-masing listing.</small><label>Ketersediaan<select name="availability"><option value="">Semua status</option>{% for v in ['tersedia','dipesan','terisi'] %}<option value="{{ v }}" {% if v==filters.availability %}selected{% endif %}>{{ v | availability }}</option>{% endfor %}</select></label><label>Minimal kamar tidur<input type="number" min="0" max="1000" name="bedrooms" value="{{ filters.bedrooms or '' }}"></label><label>Tipe indekos<select name="kos_type"><option value="">Semua tipe</option>{% for v in ['putra','putri','campur'] %}<option value="{{ v }}" {% if v==filters.kos_type %}selected{% endif %}>{{ v | capitalize }}</option>{% endfor %}</select></label><div class="form-grid"><label>Luas tanah min. (m²)<input name="min_land" type="number" min="0" value="{{ filters.min_land }}"></label><label>Luas tanah maks. (m²)<input name="max_land" type="number" min="0" value="{{ filters.max_land }}"></label></div><label>Urutkan<select name="sort"><option value="terbaru" {% if filters.sort=='terbaru' %}selected{% endif %}>Terbaru</option><option value="termurah" {% if filters.sort=='termurah' %}selected{% endif %}>Harga termurah</option><option value="termahal" {% if filters.sort=='termahal' %}selected{% endif %}>Harga termahal</option></select></label><button class="btn btn-primary">{{ icon('search') }}Terapkan Filter</button></form></aside><section><div class="results-heading"><p><strong>{{ total }}</strong> properti ditemukan</p><span>Halaman {{ page }}{% if pages %} dari {{ pages }}{% endif %}</span></div><div class="property-grid catalog-grid">{% for p in items %}{{ card(p) }}{% else %}<div class="empty panel"><h2>Belum ada yang sesuai.</h2><p>Coba longgarkan filter atau minta bantuan admin.</p><a href="/properti" class="btn btn-light">Reset Filter</a>{{ wa('Minta Dicarikan Properti','search') }}</div>{% endfor %}</div>{% if pages>1 %}<nav class="pagination" aria-label="Halaman hasil">{% for p in pageLinks %}<a href="{{ p.url }}" {% if p.number==page %}aria-current="page"{% endif %}>{{ p.number }}</a>{% endfor %}</nav>{% endif %}</section></div>{% endblock %}

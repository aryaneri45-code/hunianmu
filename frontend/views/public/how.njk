{% extends 'layouts/public.njk' %}{% from 'partials/macros.njk' import icon,wa %}{% block content %}<div class="container page-intro"><p class="eyebrow">CARA KERJA HUNIANMU</p><h1>Langkah kecil menuju tempat baru.</h1><p>Dari mencari, melihat langsung, sampai mempromosikan properti.</p></div><div class="container guide-grid section">{% for g in guides %}<section class="panel guide"><span class="step-number">0{{ loop.index }}</span><h2>{{ g.title }}</h2><ol>{% for s in g.body | lines %}<li>{{ s }}</li>{% endfor %}</ol><a href="{{ '/iklankan' if g.slug=='iklan' else '/properti' }}" class="btn btn-primary">{{ 'Iklankan Properti/Usaha' if g.slug=='iklan' else 'Cari Properti' }}{{ icon('arrow') }}</a></section>{% endfor %}</div><section class="container section"><div class="contact-band"><div><h2>Masih ada yang ingin ditanyakan?</h2><p>Admin siap membantu menjelaskan prosesnya.</p></div>{{ wa() }}</div></section>{% endblock %}

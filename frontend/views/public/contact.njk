{% extends 'layouts/public.njk' %}{% from 'partials/macros.njk' import icon,wa %}{% block content %}<div class="container page-intro"><p class="eyebrow">KONTAK HUNIANMU</p><h1>Mari mulai percakapan.</h1><p>Tanya properti, konsultasi iklan, atau ceritakan kebutuhanmu.</p></div><div class="container contact-grid section"><section class="contact-band"><div>{{ icon('chat') }}<h2>Hubungi admin via WhatsApp</h2><p>+{{ settings.whatsapp_number }}</p><p>{{ settings.service_hours }}</p>{{ wa('Mulai Percakapan') }}</div></section><section class="panel"><h2>Tetap terhubung</h2><p>Wilayah layanan: {{ settings.service_area }}</p><div class="social-links">{% if settings.instagram_url %}<a href="{{ settings.instagram_url }}" target="_blank" rel="noopener noreferrer">Instagram {{ icon('arrow') }}</a>{% endif %}{% if settings.tiktok_url %}<a href="{{ settings.tiktok_url }}" target="_blank" rel="noopener noreferrer">TikTok {{ icon('arrow') }}</a>{% endif %}{% if settings.facebook_url %}<a href="{{ settings.facebook_url }}" target="_blank" rel="noopener noreferrer">Facebook {{ icon('arrow') }}</a>{% endif %}{% if not settings.instagram_url and not settings.tiktok_url and not settings.facebook_url %}<p>Tautan media sosial belum dikonfigurasi.</p>{% endif %}</div><hr><p>Punya properti atau usaha yang ingin dipromosikan?</p><a class="btn btn-light" href="/iklankan">Lihat Layanan Iklan {{ icon('arrow') }}</a></section></div>{% endblock %}

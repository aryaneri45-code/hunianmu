{% extends 'layouts/admin.njk' %}{% from 'partials/macros.njk' import csrf as csrfField,field %}{% block content %}<h1>Pengaturan Situs</h1><p>Perubahan disimpan ke PostgreSQL dan berlaku tanpa deploy ulang.</p><form class="panel" method="post" action="/api/admin/settings" data-admin-form>{{ csrfField(csrf) }}<h2>Operasional & kontak</h2><label>Mode demo<select name="demo_mode"><option value="true" {% if settings.demo_mode=='true' %}selected{% endif %}>Aktif — tampilkan penanda demo</option><option value="false" {% if settings.demo_mode=='false' %}selected{% endif %}>Nonaktif</option></select></label><div class="form-grid">{{ field('WhatsApp admin (62 tanpa +)','whatsapp_number',settings.whatsapp_number,'text',true) }}{{ field('Jam layanan','service_hours',settings.service_hours,'text',true) }}{{ field('Wilayah layanan','service_area',settings.service_area,'text',true) }}{{ field('Instagram URL','instagram_url',settings.instagram_url,'url') }}{{ field('TikTok URL','tiktok_url',settings.tiktok_url,'url') }}{{ field('Facebook URL','facebook_url',settings.facebook_url,'url') }}</div><h2>SEO</h2>{{ field('Judul situs','seo_title',settings.seo_title,'text',true) }}<label>Deskripsi situs<textarea name="seo_description" maxlength="320" required>{{ settings.seo_description }}</textarea></label><h2>Templat WhatsApp</h2><p>Variabel: {kode}, {judul}, {url}, {nama}, {paket}, {jenis}, {lokasi}, {tanggal}, {deskripsi}. Kode dan URL listing tetap disertakan untuk konteks listing.</p>{% for key,label in [['whatsapp_listing','Tanya ketersediaan'],['whatsapp_general','Kontak umum'],['whatsapp_ad','Pengajuan iklan'],['whatsapp_ad_direct','Konsultasi iklan langsung'],['whatsapp_survey','Pengajuan survei']] %}<label>{{ label }}<textarea name="{{ key }}" required rows="3">{{ settings[key] }}</textarea></label>{% endfor %}<p class="form-feedback" role="alert"></p><button class="btn btn-primary">Simpan Pengaturan</button></form><h2>Konten halaman</h2><p>Gunakan satu baris per langkah untuk panduan Cara Kerja.</p>{% for p in pages %}<details class="panel"><summary>{{ p.title }}</summary><form method="post" action="/api/admin/pages/{{ p.slug }}" data-admin-form>{{ csrfField(csrf) }}{{ field('Judul','title',p.title,'text',true) }}<label>Isi<textarea name="body" rows="6" required>{{ p.body | replace('\\n','\n') }}</textarea></label><p class="form-feedback" role="alert"></p><button class="btn btn-primary">Simpan Konten</button></form></details>{% endfor %}{% endblock %}

{% extends 'layouts/admin.njk' %}{% from 'partials/macros.njk' import icon %}{% block content %}<div class="section-heading"><div><p class="eyebrow">RINGKASAN OPERASIONAL</p><h1>Selamat datang, {{ admin.name }}.</h1><p>Kelola properti dan tindak lanjuti setiap peluang.</p></div><a class="btn btn-primary" href="/admin/properties/new">+ Listing Baru</a></div><div class="stats-grid"><article class="panel"><span>Listing aktif</span><strong>{{ stats.active }}</strong>{{ icon('home') }}</article><article class="panel"><span>Belum diperbarui >30 hari</span><strong>{{ stats.stale }}</strong>{{ icon('building') }}</article><article class="panel"><span>Klik WhatsApp</span><strong>{{ stats.clicks }}</strong>{{ icon('chat') }}</article><article class="panel"><span>Pengajuan baru</span><strong>{{ stats.requests }}</strong>{{ icon('check') }}</article></div><section class="panel"><div class="section-heading"><div><h2>Klik WhatsApp per listing & sumber</h2><p>Pengiriman formulir dicatat sebagai event tersendiri.</p></div></div><div class="table-scroll"><table><thead><tr><th>Listing</th><th>Sumber</th><th>Total klik</th></tr></thead><tbody>{% for c in clicks %}<tr><td>{{ c.code }}</td><td>{{ c.source }}</td><td>{{ c.total }}</td></tr>{% else %}<tr><td colspan="3">Belum ada klik WhatsApp.</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}

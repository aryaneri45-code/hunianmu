{% extends 'layouts/admin.njk' %}{% from 'partials/macros.njk' import csrf as csrfField %}{% block content %}<div class="section-heading"><div><p class="eyebrow">KOTAK MASUK</p><h1>{{ title }}</h1><p>Baru → Dihubungi → Deal / Ditolak. Catatan hanya tersedia untuk admin.</p></div><span>{{ requests | length }} pengajuan</span></div><div class="request-list">{% for r in requests %}<article class="panel"><div class="section-heading"><div><h2>{{ r.name }}</h2><span class="pill">{{ r.status | capitalize }}</span> <small>{{ r.created_at | date }} · #{{ r.id }}</small></div><span>{{ r.whatsapp }}</span></div>{% if kind=='ad' %}<p><strong>{{ r.kind | capitalize }} · {{ r.package_name }}</strong><br>{{ r.location }}</p><p class="pre-line">{{ r.description }}</p>{% if r.photo_url %}<a href="{{ r.photo_url }}" target="_blank" rel="noopener noreferrer">Lihat tautan materi</a>{% endif %}{% else %}<p>{{ r.code }} · {{ r.property_title }}</p><p>Waktu yang diinginkan (WIB): <time>{{ r.preferred_at | datetime }}</time></p>{% endif %}<form method="post" action="/api/admin/{{ kind }}-requests/{{ r.id }}" data-admin-form>{{ csrfField(csrf) }}<div class="form-grid"><label>Status<select name="status">{% for v in ['baru','dihubungi','deal','ditolak'] %}<option {% if r.status==v %}selected{% endif %}>{{ v }}</option>{% endfor %}</select></label><label>Catatan internal<textarea name="notes" rows="2">{{ r.notes }}</textarea></label></div><p class="form-feedback" role="alert"></p><button class="btn btn-primary">Simpan Tindak Lanjut</button></form></article>{% else %}<div class="panel empty"><h2>Belum ada pengajuan.</h2><p>Pengajuan baru akan muncul di sini secara otomatis setelah disimpan.</p></div>{% endfor %}</div>{% endblock %}

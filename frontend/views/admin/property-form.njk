{% extends 'layouts/admin.njk' %}{% from 'partials/macros.njk' import icon,csrf as csrfField,field %}{% block content %}<div class="section-heading"><div><p class="eyebrow">{{ property.code or 'LISTING BARU' }}</p><h1>{{ title }}</h1><p>Simpan listing, tambahkan foto, lalu terbitkan.</p></div><a href="/admin/properties" class="btn btn-light">← Daftar Listing</a></div><form action="/api/admin/properties{% if property.id %}/{{ property.id }}{% endif %}" method="post" data-admin-form data-property-form>{{ csrfField(csrf) }}<div class="edit-layout"><div><section class="panel"><h2>Informasi utama</h2>{{ field('Judul listing','title',property.title,'text',true) }}{{ field('Slug URL','slug',property.slug,'text',true,'Huruf kecil dan tanda hubung; pengalihan 301 dibuat saat slug berubah.') }}<label>Deskripsi *<textarea name="description" rows="5" minlength="20" maxlength="20000" required>{{ property.description }}</textarea><span class="field-error" data-error-for="description"></span></label><div class="form-grid"><label>Kategori *<select name="type_id" required><option value="">Pilih kategori</option>{% for t in types %}<option value="{{ t.id }}" {% if property.type_id==t.id %}selected{% endif %}>{{ t.name }}</option>{% endfor %}</select></label><label>Lokasi *<select name="location_id" required><option value="">Pilih lokasi</option>{% for l in locations %}<option value="{{ l.id }}" {% if property.location_id==l.id %}selected{% endif %}>{{ l.name }}</option>{% endfor %}</select></label></div>{{ field('Alamat umum (publik)','public_address',property.public_address,'text',true,'Gunakan area atau patokan umum. Jangan masukkan alamat pribadi pemilik.') }}<div class="form-grid">{{ field('Harga (Rupiah)','price',property.price or 0,'number',true) }}<label>Periode harga<select name="price_period">{% for v,label in [['bulan','Per bulan'],['tahun','Per tahun'],['sekali','Sekali bayar']] %}<option value="{{ v }}" {% if property.price_period==v %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></label></div></section><section class="panel"><h2>Spesifikasi & fasilitas</h2><div class="form-grid">{{ field('Luas tanah (m²)','land_area',property.land_area or 0,'number') }}{{ field('Luas bangunan (m²)','building_area',property.building_area or 0,'number') }}{{ field('Kamar tidur','bedrooms',property.bedrooms or 0,'number') }}{{ field('Kamar mandi','bathrooms',property.bathrooms or 0,'number') }}{{ field('Sertifikat','certificate',property.certificate) }}{{ field('Kondisi furnitur','furniture',property.furniture) }}<label>Tipe indekos<select name="kos_type"><option value="">Tidak berlaku</option>{% for v in ['putra','putri','campur'] %}<option value="{{ v }}" {% if property.kos_type==v %}selected{% endif %}>{{ v | capitalize }}</option>{% endfor %}</select></label>{{ field('Ukuran kamar','room_size',property.room_size,'text',false,'Contoh: 3 × 4 m') }}</div><fieldset><legend>Fasilitas</legend><div class="checkbox-grid">{% for f in facilities %}<label class="check-label"><input type="checkbox" name="facility_ids" value="{{ f.id }}" {% if f.id in property.facility_ids %}checked{% endif %}>{{ f.name }}</label>{% endfor %}</div></fieldset><label>Aturan & informasi tambahan<textarea name="rules" rows="3">{{ property.rules }}</textarea></label>{{ field('Tautan video YouTube','video_url',property.video_url,'url',false,'YouTube HTTPS; video ditautkan agar halaman tetap ringan.') }}</section><section class="panel internal-panel"><h2>Kontak pemilik — internal</h2><p>Bagian ini hanya tersedia untuk admin.</p><div class="form-grid">{{ field('Nama pemilik','owner_name',property.owner_name) }}{{ field('Kontak pemilik','owner_contact',property.owner_contact,'tel') }}</div></section><section class="panel"><h2>SEO (opsional)</h2>{{ field('Judul SEO','seo_title',property.seo_title) }}<label>Deskripsi SEO<textarea name="seo_description" maxlength="320" rows="2">{{ property.seo_description }}</textarea></label></section></div><aside><section class="panel publish-panel"><h2>Publikasi</h2><label>Status<select name="status">{% for v in ['draf','terbit','arsip'] %}<option value="{{ v }}" {% if property.status==v %}selected{% endif %}>{{ v | capitalize }}</option>{% endfor %}</select></label><label>Ketersediaan<select name="availability">{% for v in ['tersedia','dipesan','terisi'] %}<option value="{{ v }}" {% if property.availability==v %}selected{% endif %}>{{ v | availability }}</option>{% endfor %}</select></label><label class="check-label"><input type="checkbox" name="featured" {% if property.featured %}checked{% endif %}>Listing Pilihan di Beranda</label><p class="form-feedback" tabindex="-1" role="alert"></p><button class="btn btn-primary">Simpan Listing {{ icon('check') }}</button>{% if property.id %}<a href="/admin/preview/{{ property.id }}" class="btn btn-light" target="_blank">Pratinjau</a>{% endif %}<small>Listing berstatus Terbit langsung tampil pada katalog dan sitemap.</small></section></aside></div></form>
<section class="panel" id="media"><h2>Galeri foto</h2>{% if property.id %}<p>Pilih hingga 15 foto sekaligus, maksimal 8 MB/foto (JPG, PNG, WebP); maksimal 30 foto/listing. Foto diproses menjadi tiga ukuran WebP.</p><form data-upload action="/api/admin/properties/{{ property.id }}/media" method="post" enctype="multipart/form-data"><label>Unggah foto<input name="photos" type="file" accept="image/jpeg,image/png,image/webp" multiple required></label><p class="form-feedback" role="alert"></p><button class="btn btn-primary">Unggah Foto</button></form>{% if property.media | length %}<form data-media-order data-property-id="{{ property.id }}"><div class="media-grid">{% for m in property.media %}<div class="media-tile" data-media-id="{{ m.id }}"><img src="{{ m.thumb_path }}" alt="{{ m.alt }}" width="240" height="160"><label class="check-label"><input type="radio" name="cover_id" value="{{ m.id }}" {% if m.is_cover %}checked{% endif %}>Foto sampul</label><label>Teks alternatif<input name="alt_{{ m.id }}" value="{{ m.alt }}" required></label><div><button type="button" data-move="up" class="btn btn-light" aria-label="Pindahkan foto ke kiri">←</button><button type="button" data-move="down" class="btn btn-light" aria-label="Pindahkan foto ke kanan">→</button><button type="button" data-delete-media="{{ m.id }}" class="text-button danger">Hapus</button></div></div>{% endfor %}</div><p class="form-feedback" role="alert"></p><button class="btn btn-primary">Simpan Urutan & Sampul</button></form>{% endif %}{% else %}<p>Simpan listing terlebih dahulu untuk mengunggah foto.</p>{% endif %}</section>{% endblock %}

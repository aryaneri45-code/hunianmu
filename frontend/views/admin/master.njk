{% extends 'layouts/admin.njk' %}{% from 'partials/macros.njk' import csrf as csrfField,field %}{% block content %}<h1>Master Data</h1><p>Perubahan kategori, lokasi, dan fasilitas langsung tersedia pada formulir dan filter publik.</p>{% for group,label,items in [['types','Kategori',types],['locations','Lokasi',locations],['facilities','Fasilitas',facilities]] %}<section class="panel"><h2>{{ label }}</h2><div class="master-list">{% for item in items %}<details><summary>{{ item.name }} <small>/{{ item.slug }}</small></summary><form method="post" action="/api/admin/{{ group }}/{{ item.id }}" data-admin-form>{{ csrfField(csrf) }}<div class="form-grid">{{ field('Nama','name',item.name,'text',true) }}{{ field('Slug','slug',item.slug,'text',true) }}{% if group=='locations' %}<label>Jenis<select name="kind">{% for k in ['kota','kecamatan','kelurahan'] %}<option {% if item.kind==k %}selected{% endif %}>{{ k }}</option>{% endfor %}</select></label><label>Induk lokasi<select name="parent_id"><option value="">Tanpa induk</option>{% for l in locations %}{% if l.id!=item.id %}<option value="{{ l.id }}" {% if l.id==item.parent_id %}selected{% endif %}>{{ l.name }}</option>{% endif %}{% endfor %}</select></label>{% endif %}{% if group=='facilities' %}{{ field('Ikon','icon',item.icon) }}{% endif %}</div><p class="form-feedback" role="alert"></p><button class="btn btn-primary">Simpan</button></form><form method="post" action="/api/admin/{{ group }}/{{ item.id }}/delete">{{ csrfField(csrf) }}<button class="text-button danger" data-confirm="Hapus master data ini? Data yang masih dipakai tidak bisa dihapus.">Hapus</button></form></details>{% endfor %}</div><details><summary>+ Tambah {{ label }}</summary><form method="post" action="/api/admin/{{ group }}" data-admin-form>{{ csrfField(csrf) }}<div class="form-grid">{{ field('Nama','name','','text',true) }}{{ field('Slug','slug','','text',true) }}{% if group=='locations' %}<label>Jenis<select name="kind"><option>kecamatan</option><option>kota</option><option>kelurahan</option></select></label><label>Induk lokasi<select name="parent_id"><option value="">Tanpa induk</option>{% for l in locations %}<option value="{{ l.id }}">{{ l.name }}</option>{% endfor %}</select></label>{% endif %}{% if group=='facilities' %}{{ field('Ikon','icon','check') }}{% endif %}</div><p class="form-feedback" role="alert"></p><button class="btn btn-primary">Tambah {{ label }}</button></form></details></section>{% endfor %}{% endblock %}

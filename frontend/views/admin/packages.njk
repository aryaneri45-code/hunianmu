{% extends 'layouts/admin.njk' %}{% from 'partials/macros.njk' import csrf as csrfField,field %}{% macro packageForm(p,token) %}<form method="post" action="/api/admin/ad-packages{% if p.id %}/{{ p.id }}{% endif %}" data-admin-form>{{ csrfField(token) }}<div class="form-grid">{{ field('Nama paket','name',p.name,'text',true) }}<label>Kanal<select name="channel">{% for v in ['website','sosial','gabungan'] %}<option {% if p.channel==v %}selected{% endif %}>{{ v }}</option>{% endfor %}</select></label>{{ field('Harga (Rp)','price',p.price or 0,'number',true) }}{{ field('Durasi (hari)','duration_days',p.duration_days or 30,'number',true) }}</div><label>Deskripsi<textarea name="description" minlength="10" required>{{ p.description }}</textarea></label><label>Fitur (satu per baris)<textarea name="features" required rows="4">{{ p.features | join('\n') }}</textarea></label><div class="form-grid">{{ field('Urutan','sort_order',p.sort_order or 0,'number') }}<label class="check-label"><input name="active" type="checkbox" {% if p.active %}checked{% endif %}>Paket aktif</label></div><p class="form-feedback" role="alert"></p><button class="btn btn-primary">Simpan Paket</button></form>{% endmacro %}{% block content %}<h1>Paket Iklan</h1><p>Nama, harga, durasi, fitur, dan paket aktif langsung tercermin di halaman Iklankan.</p>{% for p in packages %}<details class="panel"><summary>{{ p.name }} · {{ p.price | money }} · {{ 'Aktif' if p.active else 'Nonaktif' }}</summary>{{ packageForm(p,csrf) }}</details>{% endfor %}<details class="panel"><summary>+ Tambah Paket</summary>{{ packageForm({active:true,features:[]},csrf) }}</details>{% endblock %}

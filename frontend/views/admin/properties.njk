{% extends 'layouts/admin.njk' %}{% from 'partials/macros.njk' import icon,csrf as csrfField %}{% block content %}<div class="section-heading"><div><p class="eyebrow">KATALOG PROPERTI</p><h1>Kelola Listing</h1><p>{{ items | length }} listing · Status publikasi dan ketersediaan dikelola terpisah.</p></div><a class="btn btn-primary" href="/admin/properties/new">+ Listing Baru</a></div><section class="panel"><div class="table-scroll"><table><thead><tr><th>Listing</th><th>Harga</th><th>Publikasi</th><th>Ketersediaan (satu ketukan)</th><th>Aksi</th></tr></thead><tbody>{% for p in items %}<tr><td><small>{{ p.code }} · {{ p.category_name }}</small><a class="listing-title" href="/admin/properties/{{ p.id }}">{{ p.title }}</a><small>{{ p.location_name }} · {{ p.photos }} foto</small></td><td>{{ p.price | money }}<small>{{ p.price_period | period }}</small></td><td><span class="pill">{{ p.status | capitalize }}</span><form action="/api/admin/properties/{{ p.id }}/action" method="post">{{ csrfField(csrf) }}<input name="action" value="feature" type="hidden"><button class="text-button">{{ '★ Pilihan' if p.featured else '☆ Jadikan pilihan' }}</button></form></td><td><form action="/api/admin/properties/{{ p.id }}/action" method="post" class="quick-status">{{ csrfField(csrf) }}<input name="action" value="availability" type="hidden">{% for status in ['tersedia','dipesan','terisi'] %}<button class="status-button {% if p.availability==status %}selected{% endif %}" name="availability" value="{{ status }}" aria-pressed="{{ 'true' if p.availability==status else 'false' }}">{{ status | availability }}</button>{% endfor %}</form></td><td><div class="row-actions"><a href="/admin/properties/{{ p.id }}" class="btn btn-light">Ubah</a><a href="/admin/preview/{{ p.id }}" class="btn btn-light">Pratinjau</a><form method="post" action="/api/admin/properties/{{ p.id }}/action">{{ csrfField(csrf) }}<button name="action" value="duplicate" class="text-button">Duplikasi</button><button name="action" value="archive" class="text-button">Arsipkan</button><button name="action" value="delete" class="text-button danger" data-confirm="Hapus listing ini dari katalog? Listing tetap tersimpan sebagai soft delete.">Hapus</button></form></div></td></tr>{% else %}<tr><td colspan="5">Belum ada listing. Mulai dari Listing Baru.</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}

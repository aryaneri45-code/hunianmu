{% from 'partials/macros.njk' import icon,csrf as csrfField %}<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Login Admin — HunianMu</title><meta name="robots" content="noindex,nofollow"><link rel="stylesheet" href="/static/build/main.css"></head><body class="login-body"><main class="login-card"><a href="/" class="brand"><img src="/static/img/logo.webp" width="160" height="48" alt="HunianMu"></a><span class="login-icon">{{ icon('shield') }}</span><p class="eyebrow">PANEL ADMIN</p><h1>Selamat datang kembali.</h1><p>Masuk untuk mengelola listing dan pengajuan HunianMu.</p>{% if error %}<p class="notice error" role="alert">{{ error }}</p>{% endif %}<form action="/api/admin/login" method="post">{{ csrfField(csrf) }}<label>Email<input type="email" name="email" autocomplete="username" required></label><label>Kata sandi<input type="password" name="password" autocomplete="current-password" required></label><button class="btn btn-primary">Masuk ke Panel Admin {{ icon('arrow') }}</button></form><small>Akses khusus pengelola HunianMu.</small><a href="/" class="text-link">← Kembali ke website</a></main></body></html>

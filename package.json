{
  "name": "hunianmu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch backend/src/server.ts",
    "start": "node backend/dist/server.js",
    "build": "tsc && npm run build:assets",
    "build:assets": "tailwindcss -c frontend/tailwind.config.js -i frontend/assets/css/main.css -o frontend/public/build/main.css --minify && cp frontend/assets/js/*.js frontend/public/build/",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint backend/src backend/scripts frontend/scripts database/scripts tests --max-warnings 0",
    "db:migrate": "tsx backend/src/db/migrate.ts",
    "db:seed": "tsx backend/src/db/seed.ts",
    "db:local": "bash database/scripts/local-postgres.sh",
    "admin:create": "tsx backend/scripts/create-admin.ts",
    "admin:sync-local": "tsx backend/scripts/sync-local-admin.ts",
    "test": "tsx --test tests/integration.test.ts",
    "test:e2e": "tsx tests/e2e.ts",
    "test:backup": "tsx database/scripts/verify-backup.ts",
    "demo:assets": "tsx frontend/scripts/prepare-demo-assets.ts"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/secure-session": "^8.4.2",
    "@fastify/static": "^10.1.10",
    "@fastify/view": "^12.0.1",
    "argon2": "^0.45.2",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "nunjucks": "^3.2.4",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/nunjucks": "^3.2.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "lighthouse": "^13.6.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
